<?xml version="1.0" encoding="utf-8" ?>
<views:BasePowerControlHubContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PowerControlHubApp.ViewModels"
             xmlns:models="clr-namespace:PowerControlHubApp.Models"
             xmlns:converters="clr-namespace:PowerControlHubApp.Converters"
             xmlns:views="clr-namespace:PowerControlHubApp.Views"
             xmlns:localization="clr-namespace:PowerControlHubApp.Resources.Localization"
             xmlns:internal="clr-namespace:PowerControlHubApp.Internal"
             x:Class="PowerControlHubApp.Views.LocalSensorConfigPage"
             Title="{x:Static localization:AppResources.LocalSensorsPageTitle}"
             BackgroundColor="{DynamicResource AppPageBg}">

    <views:BasePowerControlHubContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />

            <Style x:Key="SensorCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource AppCardBg}" />
                <Setter Property="Stroke" Value="{DynamicResource AppCardStroke}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="SensorNameLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource AppLabelPrimary}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="SensorSubLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource AppLabelMuted}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="BadgeLabel" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </views:BasePowerControlHubContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" BackgroundColor="{DynamicResource AppPageBg}">

        <!-- Top bar -->
        <views:TopBarView Grid.Row="0" 
            Title="{x:Static internal:Constants.IconLocalSensor} {x:Static localization:AppResources.LocalSensorsTitle}"
            RightButtonText="↻"
            RightButtonCommand="{Binding LoadCommand}"
            RightButtonIsEnabled="{Binding IsNotBusy}" />

        <!-- Not connected banner -->
        <views:NotConnectedBanner Grid.Row="1" />

        <!-- Content -->
        <Grid Grid.Row="2" IsVisible="{Binding IsConnected}">

            <!-- Sensor list (8 preconfigured slots) -->
            <CollectionView ItemsSource="{Binding Sensors}"
                            Margin="16,12">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LocalSensorConfigModel">
                        <Border Style="{StaticResource SensorCard}"
                                Opacity="{Binding IsConfigured, Converter={x:StaticResource BoolToOpacityConverter}}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                  ColumnSpacing="10">

                                <!-- Index circle -->
                                <Border Grid.Column="0"
                                        BackgroundColor="{DynamicResource AppCardStroke}"
                                        StrokeShape="RoundRectangle 14"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Index}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource AppAccent}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>

                                <!-- Name + pin summary -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding DisplayName}"
                                           Style="{StaticResource SensorNameLabel}" />
                                    <Label Style="{StaticResource SensorSubLabel}">
                                        <Label.Text>
                                            <Binding Path="PinSummary" />
                                        </Label.Text>
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsEnabled}" Value="False">
                                                <Setter Property="Text" Value="{x:Static localization:AppResources.SensorNotConfigured}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>

                                <!-- Type badge -->
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="0"
                                        VerticalOptions="Center">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding SensorType}" Value="0">
                                            <Setter Property="BackgroundColor" Value="#1a3a5c" />
                                            <Setter Property="Stroke" Value="#0f3460" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding SensorType}" Value="1">
                                            <Setter Property="BackgroundColor" Value="#1a3a1a" />
                                            <Setter Property="Stroke" Value="#2a5a2a" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding SensorType}" Value="2">
                                            <Setter Property="BackgroundColor" Value="#3a3a1a" />
                                            <Setter Property="Stroke" Value="#5a5a2a" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding SensorType}" Value="3">
                                            <Setter Property="BackgroundColor" Value="#1a1a3a" />
                                            <Setter Property="Stroke" Value="#2a2a5a" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding SensorType}" Value="5">
                                            <Setter Property="BackgroundColor" Value="#2a1a3a" />
                                            <Setter Property="Stroke" Value="#4a2a5a" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding SensorType}" Value="6">
                                            <Setter Property="BackgroundColor" Value="#3a1a1a" />
                                            <Setter Property="Stroke" Value="#5a2a2a" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Style="{StaticResource BadgeLabel}"
                                           TextColor="{DynamicResource AppLabelMuted}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding SensorType}" Value="0">
                                                <Setter Property="Text" Value="{x:Static localization:AppResources.SensorTypeWater}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding SensorType}" Value="1">
                                                <Setter Property="Text" Value="{x:Static localization:AppResources.SensorTypeDht11}" />
                                                <Setter Property="TextColor" Value="#66cc66" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding SensorType}" Value="2">
                                                <Setter Property="Text" Value="{x:Static localization:AppResources.SensorTypeLight}" />
                                                <Setter Property="TextColor" Value="#cccc66" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding SensorType}" Value="3">
                                                <Setter Property="Text" Value="{x:Static localization:AppResources.SensorTypeGps}" />
                                                <Setter Property="TextColor" Value="#6699cc" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding SensorType}" Value="4">
                                                <Setter Property="Text" Value="{x:Static localization:AppResources.SensorTypeSystem}" />
                                                <Setter Property="TextColor" Value="#888888" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding SensorType}" Value="5">
                                                <Setter Property="Text" Value="{x:Static localization:AppResources.SensorTypePresence}" />
                                                <Setter Property="TextColor" Value="#cc66cc" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding SensorType}" Value="6">
                                                <Setter Property="Text" Value="{x:Static localization:AppResources.SensorTypeVoltage}" />
                                                <Setter Property="TextColor" Value="#cc6666" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <!-- Chevron -->
                                <Label Grid.Column="3"
                                       Text="›"
                                       FontSize="22"
                                       TextColor="{DynamicResource AppLabelMuted}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Tap gesture -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LocalSensorConfigViewModel}}, Path=NavigateToSensorCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <views:StatusBarView Grid.Row="3" />
    </Grid>
</views:BasePowerControlHubContentPage>
