<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PowerControlHubApp.ViewModels"
             xmlns:localization="clr-namespace:PowerControlHubApp.Resources.Localization"
             xmlns:internal="clr-namespace:PowerControlHubApp.Internal"
             x:Class="PowerControlHubApp.Views.StatusBarView">

    <ContentView.Content>
        <Grid RowDefinitions="Auto,Auto,Auto">
            <!-- ── System status bar (memory/cpu/time/fw) ── -->
            <Grid x:Name="SystemStatusGrid" Grid.Row="0" BackgroundColor="{DynamicResource AppBarBg}" Padding="12,6" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" SizeChanged="OnSystemStatusGridSizeChanged">
                <Label x:Name="MemLabel" Grid.Column="0" Text="{x:Static localization:AppResources.MemLabel}" TextColor="{DynamicResource AppBarText}" VerticalOptions="Center" Margin="12,0" />
                <Label x:Name="MemValue" Grid.Column="1" Text="{Binding SystemFreeMemory}" TextColor="{DynamicResource AppBarText}" VerticalOptions="Center" Margin="6,0" />
                <Label x:Name="CpuLabel" Grid.Column="2" Text="{x:Static localization:AppResources.CpuLabel}" TextColor="{DynamicResource AppBarText}" VerticalOptions="Center" Margin="12,0" />
                <Label x:Name="CpuValue" Grid.Column="3" Text="{Binding SystemCpuUsage}" TextColor="{DynamicResource AppBarText}" VerticalOptions="Center" Margin="6,0" />
                <Label x:Name="WarningLabel" Grid.Column="4" Text="⚠" TextColor="{Binding SystemStatusColor}" VerticalOptions="Center" FontSize="14" IsVisible="{Binding HasWarnings}" Margin="4,0,0,0" />
                <Label x:Name="SystemLabel" Grid.Column="5" Text="{x:Static localization:AppResources.SystemTitle}" TextColor="{Binding SystemStatusColor}" VerticalOptions="Center" FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SystemLabelTappedCommand}" NumberOfTapsRequired="1" />
                    </Label.GestureRecognizers>
                </Label>
                <Label x:Name="FirmwareLabel" Grid.Column="6" TextColor="{Binding SystemFirmwareColor}" VerticalOptions="Center" HorizontalOptions="End">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static localization:AppResources.FwPrefix}" />
                            <Span Text="{Binding SystemFirmware}" />
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding FirmwareLabelTappedCommand}" NumberOfTapsRequired="1" />
                    </Label.GestureRecognizers>
                </Label>
                <Label x:Name="TimeLabel" Grid.Column="7" TextColor="{DynamicResource AppBarText}" VerticalOptions="Center" Margin="12,0" FontSize="11">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static internal:Constants.IconTimePrefix}" />
                            <Span Text="{Binding SystemTime}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label x:Name="UptimeLabel" Grid.Column="8" Text="{Binding SystemUptime}" TextColor="{DynamicResource AppBarText}" VerticalOptions="Center" Margin="12,0" />
            </Grid>

            <Grid Grid.Row="1" BackgroundColor="{DynamicResource AppBarBg}" Padding="12,6"
                  ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
                <BoxView Grid.Column="1"
                         Color="{Binding StatusColor}"
                         WidthRequest="9" HeightRequest="9"
                         CornerRadius="5"
                         VerticalOptions="Center"
                         Margin="0,0,6,0" />
                <Label Grid.Column="2"
                       Text="{Binding StatusMessage}"
                       TextColor="{Binding StatusColor}"
                       FontSize="11"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation" />
                <Button Grid.Column="3"
                        Text="↻"
                        FontSize="16"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource AppBarText}"
                        Padding="4,0"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        ToolTipProperties.Text="{x:Static localization:AppResources.RefreshNowTooltip}" />
                <ActivityIndicator Grid.Column="4"
                   IsRunning="{Binding IsBusy}"
                   IsVisible="{Binding IsBusy}"
                   Color="{DynamicResource AppBarText}"
                   WidthRequest="14"
                   HeightRequest="14"
                   VerticalOptions="Center"
                   Margin="6,0,0,0" />
                <Button Grid.Column="4"
                        Text="📋"
                        FontSize="14"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource AppBarText}"
                        Padding="4,0"
                        Clicked="OnToggleLogClicked" />
            </Grid>

            <Grid x:Name="LogPanel"
                  Grid.Row="2"
                  IsVisible="False"
                  BackgroundColor="{DynamicResource AppLogPanelBg}"
                  RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Padding="12,6" ColumnDefinitions="*,Auto"
                      BackgroundColor="{DynamicResource AppBarBg}">
                    <Label Grid.Column="0"
                           Text="{x:Static localization:AppResources.LogLabel}"
                           TextColor="{DynamicResource AppBarText}"
                           FontSize="12"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="{x:Static localization:AppResources.LabelClear}"
                            FontSize="11"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource AppBarText}"
                            Padding="6,0"
                            Clicked="OnClearLogClicked" />
                </Grid>
                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding LogEntries}"
                                SelectionMode="None"
                                HeightRequest="160">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntryViewModel">
                            <Grid ColumnDefinitions="Auto,Auto,*" Padding="10,3">
                                <Label Grid.Column="0"
                                       Text="{Binding FormattedTime}"
                                       TextColor="{DynamicResource AppLogTimestamp}"
                                       FontSize="10"
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0" />
                                <Label Grid.Column="1"
                                       Text="{Binding Level}"
                                       TextColor="{Binding LevelColor}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0" />
                                <Label Grid.Column="2"
                                       Text="{Binding Message}"
                                       TextColor="{DynamicResource AppLogText}"
                                       FontSize="10"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
    </ContentView.Content>

</ContentView>
