<?xml version="1.0" encoding="utf-8" ?>
<views:BasePowerControlHubContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PowerControlHubApp.ViewModels"
             xmlns:models="clr-namespace:PowerControlHubApp.Models"
             xmlns:converters="clr-namespace:PowerControlHubApp.Converters"
             xmlns:views="clr-namespace:PowerControlHubApp.Views"
             xmlns:localization="clr-namespace:PowerControlHubApp.Resources.Localization"
             xmlns:internal="clr-namespace:PowerControlHubApp.Internal"
             x:Class="PowerControlHubApp.Views.ExternalSensorConfigPage"
             x:Name="PageRoot"
             Title="{x:Static localization:AppResources.ExtSensorsTitle}"
             BackgroundColor="{DynamicResource AppPageBg}">

    <views:BasePowerControlHubContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />

            <Style x:Key="SensorCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource AppCardBg}" />
                <Setter Property="Stroke" Value="{DynamicResource AppCardStroke}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="SensorNameLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource AppLabelPrimary}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="SensorSubLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource AppLabelMuted}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </views:BasePowerControlHubContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" BackgroundColor="{DynamicResource AppPageBg}">

        <!-- Top bar -->
        <views:TopBarView Grid.Row="0" 
            Title="{x:Static internal:Constants.IconExternalSensor} {x:Static localization:AppResources.ExternalSensorsTitle}"
            RightButtonText="↻"
            RightButtonCommand="{Binding LoadCommand}"
            RightButtonIsEnabled="{Binding IsNotBusy}" />

        <!-- Not connected banner -->
        <views:NotConnectedBanner Grid.Row="1" />

        <!-- Content -->
        <Grid Grid.Row="2" IsVisible="{Binding IsConnected}">

            <!-- Status / error message -->
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatus}"
                   TextColor="{DynamicResource AppAccent}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   Margin="20,0" />

            <!-- Sensor list (8 preconfigured slots) -->
            <CollectionView ItemsSource="{Binding Sensors}"
                            Margin="16,12">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ExternalSensorConfigModel">
                        <Border Style="{StaticResource SensorCard}"
                                Opacity="{Binding IsConfigured, Converter={x:StaticResource BoolToOpacityConverter}}">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10">

                                <!-- Index circle -->
                                <Border Grid.Column="0"
                                        BackgroundColor="{DynamicResource AppCardStroke}"
                                        StrokeShape="RoundRectangle 14"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Index}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource AppAccent}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>

                                <!-- Name + type -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding DisplayName}"
                                           Style="{StaticResource SensorNameLabel}" />
                                    <Label Style="{StaticResource SensorSubLabel}">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="SensorTypeName" />
                                                <Binding Path="MqttName" />
                                            </MultiBinding>
                                        </Label.Text>
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsConfigured}" Value="False">
                                                <Setter Property="Text" Value="{x:Static localization:AppResources.SensorNotConfigured}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>

                                <!-- Chevron -->
                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="22"
                                       TextColor="{DynamicResource AppLabelMuted}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Tap gesture -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ExternalSensorConfigViewModel}}, Path=NavigateToSensorCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <views:StatusBarView Grid.Row="3" />
    </Grid>
</views:BasePowerControlHubContentPage>
