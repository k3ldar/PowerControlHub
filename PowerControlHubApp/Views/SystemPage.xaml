<?xml version="1.0" encoding="utf-8" ?>
<views:BasePowerControlHubContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:PowerControlHubApp.Views"
             xmlns:localization="clr-namespace:PowerControlHubApp.Resources.Localization"
             x:Class="PowerControlHubApp.Views.SystemPage"
             Title="{x:Static localization:AppResources.SystemTitle}"
             BackgroundColor="{DynamicResource AppPageBg}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" BackgroundColor="{DynamicResource AppPageBg}">
        <views:TopBarView Grid.Row="0" Title="{x:Static localization:AppResources.SystemTitle}"
                  RightButtonText="↻"
                  RightButtonCommand="{Binding RefreshCommand}"
                  RightButtonIsEnabled="{Binding IsNotBusy}" />

        <!-- Not connected banner -->
        <views:NotConnectedBanner Grid.Row="1" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="20" Spacing="12">
                <!-- Settings navigation card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}" Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Center" IsEnabled="{Binding IsConnected}">
                        <Button Text="{x:Static localization:AppResources.Time}"
                                Command="{Binding NavigateToTimeSettingsCommand}"
                                FontSize="16"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource AppAccent}"
                                Padding="4"
                                Margin="8"
                                BorderColor="Blue"
                                BorderWidth="1"/>
                        <Button Text="{x:Static localization:AppResources.RTC}"
                                Command="{Binding NavigateToRtcSettingsCommand}"
                                FontSize="16"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource AppAccent}"
                                Padding="4"
                                Margin="8"
                                BorderColor="Blue"
                                BorderWidth="1"/>
                        <Button Text="{x:Static localization:AppResources.Location}"
                                Command="{Binding NavigateToLocationSettingsCommand}"
                                FontSize="16"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource AppAccent}"
                                Padding="4"
                                Margin="8"
                                BorderColor="Blue"
                                BorderWidth="1"/>
                        <Button Text="{x:Static localization:AppResources.MQTT}"
                                Command="{Binding NavigateToMqttSettingsCommand}"
                                FontSize="16"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource AppAccent}"
                                Padding="4"
                                Margin="8"
                                BorderColor="Blue"
                                BorderWidth="1"/>
                        <Button Text="{x:Static localization:AppResources.SDCard}"
                                Command="{Binding NavigateToSdCardSettingsCommand}"
                                FontSize="16"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource AppAccent}"
                                Padding="4"
                                Margin="8"
                                BorderColor="Blue"
                                BorderWidth="1"/>
                        <Button Text="{x:Static localization:AppResources.Security}"
                                Command="{Binding NavigateToNetworkSecurityCommand}"
                                FontSize="16"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource AppAccent}"
                                Padding="4"
                                Margin="8"
                                BorderColor="Blue"
                                BorderWidth="1"/>
                        <Button Text="{x:Static localization:AppResources.Nextion}"
                                Command="{Binding NavigateToNextionSettingsCommand}"
                                FontSize="16"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource AppAccent}"
                                Padding="4"
                                Margin="8"
                                BorderColor="Blue"
                                BorderWidth="1"/>
                        <Button Text="{x:Static localization:AppResources.Buzzer}"
                                Command="{Binding NavigateToXpdzToneSettingsCommand}"
                                FontSize="16"
                                FontAttributes="Bold"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource AppAccent}"
                                Padding="4"
                                Margin="8"
                                BorderColor="Blue"
                                BorderWidth="1"/>
                    </FlexLayout>
                </Border>

                <!-- Language selection card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}" Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{x:Static localization:AppResources.LanguageLabel}"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontSize="13" />
                        <Border BackgroundColor="{DynamicResource AppEntryBg}" Stroke="{DynamicResource AppEntryStroke}"
                                StrokeShape="RoundRectangle 8" Padding="0">
                            <Picker ItemsSource="{Binding LanguageOptions}"
                                    SelectedItem="{Binding SelectedLanguage}"
                                    TextColor="{DynamicResource AppEntryText}"
                                    BackgroundColor="Transparent"
                                    TitleColor="{DynamicResource AppPlaceholderText}"
                                    Margin="10,0" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Warnings card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}" Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14" IsEnabled="{Binding IsConnected}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.ActiveWarnings}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource AppAccent}" />

                        <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatusMessage}" TextColor="{DynamicResource AppLabelMuted}" />

                        <CollectionView ItemsSource="{Binding Warnings}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Label Text="{Binding .}" FontSize="14" TextColor="{DynamicResource AppLabelPrimary}" />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="{x:Static localization:AppResources.MessageNoActiveWarnings}" TextColor="{DynamicResource AppLabelMuted}" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- GPIO Pins In Use card (moved from Settings) -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}" Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14" IsEnabled="{Binding IsConnected}"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{x:Static localization:AppResources.GpiosInUse}"
                                   TextColor="{DynamicResource AppLabelMuted}"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="↻"
                                    FontSize="14"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource AppLabelMuted}"
                                    Padding="4,0"
                                    HeightRequest="28"
                                    Command="{Binding RefreshPinsCommand}" />
                        </Grid>

                        <!-- Loading indicator -->
                        <ActivityIndicator IsRunning="{Binding IsPinsRefreshing}"
                                           IsVisible="{Binding IsPinsRefreshing}"
                                           Color="{DynamicResource AppAccent}"
                                           HeightRequest="20" />

                        <!-- Pins list (hidden while refreshing) -->
                        <Label Text="{Binding PinsInUseText}"
                               TextColor="{DynamicResource AppEntryText}"
                               FontSize="14"
                               FontFamily="OpenSansRegular"
                               IsVisible="{Binding IsNotPinsRefreshing}"
                               LineBreakMode="WordWrap" />

                        <!-- Count -->
                        <Label TextColor="{DynamicResource AppLabelSubtle}" FontSize="11"
                               IsVisible="{Binding HasPins}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding PinsCount}" />
                                    <Span Text="{x:Static localization:AppResources.PinsAssignedSuffix}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Border>

                <!-- GPIO Pin Restrictions card (compile-time — fetched once) -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}" Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14" IsEnabled="{Binding IsConnected}"
                        Margin="0,8,0,0"
                        IsVisible="{Binding HasPinRestrictions}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.GpioRestrictions}"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13"
                               VerticalOptions="Center" />

                        <!-- Hard-blocked pins -->
                        <VerticalStackLayout Spacing="2">
                            <Label TextColor="{DynamicResource AppLabelSubtle}" FontSize="14">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static localization:AppResources.HardBlockedPrefix}" FontAttributes="Bold" />
                                        <Span Text="{Binding HardPinsText}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>

                        <!-- Advisory pins -->
                        <VerticalStackLayout Spacing="2">
                            <Label TextColor="{DynamicResource AppLabelSubtle}" FontSize="14">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static localization:AppResources.AdvisoryPrefix}" FontAttributes="Bold" />
                                        <Span Text="{Binding AdvisoryPinsText}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Firmware Update card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}" Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14" IsEnabled="{Binding IsConnected}"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.FirmwareUpdate}"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13"
                               VerticalOptions="Center" />

                        <Label TextColor="{DynamicResource AppEntryText}"
                               FontSize="14"
                               LineBreakMode="NoWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static localization:AppResources.CurrentVersionPrefix}" />
                                    <Span Text="{Binding CurrentFirmwareVersion}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label TextColor="{DynamicResource AppEntryText}"
                               FontSize="14"
                               LineBreakMode="NoWrap"
                               IsVisible="{Binding IsUpdateAvailable}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static localization:AppResources.AvailableVersionPrefix}" />
                                    <Span Text="{Binding AvailableFirmwareVersion}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    Text="{x:Static localization:AppResources.CheckForUpdates}"
                                    Command="{Binding CheckForUpdateCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource AppAccent}"
                                    CornerRadius="8"
                                    Padding="10,8" />
                            <Button Grid.Column="1"
                                    Text="{x:Static localization:AppResources.Install}"
                                    Command="{Binding InstallFirmwareCommand}"
                                    IsVisible="{Binding IsUpdateAvailable}"
                                    BackgroundColor="{DynamicResource AppAccent}"
                                    TextColor="White"
                                    CornerRadius="8"
                                    Padding="10,8" />
                        </Grid>

                        <ActivityIndicator IsRunning="{Binding IsOtaBusy}"
                                           IsVisible="{Binding IsOtaBusy}"
                                           Color="{DynamicResource AppAccent}"
                                           HeightRequest="20" />

                        <Label Text="{Binding StatusMessage}"
                               TextColor="{DynamicResource AppAccent}"
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding HasStatusMessage}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <views:StatusBarView Grid.Row="3" />
    </Grid>

</views:BasePowerControlHubContentPage>
