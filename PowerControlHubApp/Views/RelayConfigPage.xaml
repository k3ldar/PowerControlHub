<?xml version="1.0" encoding="utf-8" ?>
<views:BasePowerControlHubContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PowerControlHubApp.ViewModels"
             xmlns:models="clr-namespace:PowerControlHubApp.Models"
             xmlns:converters="clr-namespace:PowerControlHubApp.Converters"
             xmlns:views="clr-namespace:PowerControlHubApp.Views"
             xmlns:localization="clr-namespace:PowerControlHubApp.Resources.Localization" xmlns:internal="clr-namespace:PowerControlHubApp.Internal"
             x:Class="PowerControlHubApp.Views.RelayConfigPage"
             Title="{x:Static localization:AppResources.RelayConfigPageTitle}"
             BackgroundColor="{DynamicResource AppPageBg}">

    <views:BasePowerControlHubContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
            <Style x:Key="RelayConfigCard" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource AppCardBg}" />
                <Setter Property="Stroke" Value="{DynamicResource AppCardStroke}" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="RelayNameLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource AppLabelPrimary}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>

            <Style x:Key="RelaySubLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{DynamicResource AppLabelMuted}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="BadgeLabel" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </views:BasePowerControlHubContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" BackgroundColor="{DynamicResource AppPageBg}">

        <!-- ── Top bar ── -->
        <views:TopBarView Grid.Row="0" 
            Title="{x:Static internal:Constants.IconRelaySymbol} {x:Static localization:AppResources.RelayConfigTitle}"
            RightButtonText="↻"
            RightButtonCommand="{Binding LoadCommand}"
            RightButtonIsEnabled="{Binding IsNotBusy}" />

        <!-- Not connected banner -->
        <views:NotConnectedBanner Grid.Row="1" />

        <!-- ── Content ── -->
        <Grid Grid.Row="2" IsVisible="{Binding IsConnected}">

            <!-- Relay list -->
            <CollectionView ItemsSource="{Binding Relays}"
                            Margin="16,12">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RelayViewModel">
                        <Border Style="{StaticResource RelayConfigCard}"
                                Opacity="{Binding IsEnabled, Converter={x:StaticResource BoolToOpacityConverter}}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                  ColumnSpacing="10">

                                <!-- Index circle -->
                                <Border Grid.Column="0"
                                        BackgroundColor="{DynamicResource AppCardStroke}"
                                        StrokeShape="RoundRectangle 14"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Index}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource AppAccent}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>

                                <!-- Name + pin -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding DisplayName}"
                                           Style="{StaticResource RelayNameLabel}" />
                                    <Label Text="{Binding PinSummary}"
                                           Style="{StaticResource RelaySubLabel}" />
                                </VerticalStackLayout>

                                <!-- Action type badge -->
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="0"
                                        VerticalOptions="Center">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding ActionType}" Value="0">
                                            <Setter Property="BackgroundColor" Value="#1a3a5c" />
                                            <Setter Property="Stroke" Value="#0f3460" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding ActionType}" Value="1">
                                            <Setter Property="BackgroundColor" Value="#3a1a1a" />
                                            <Setter Property="Stroke" Value="#7a2222" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding ActionType}" Value="2">
                                            <Setter Property="BackgroundColor" Value="#1a2a3a" />
                                            <Setter Property="Stroke" Value="#335577" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Style="{StaticResource BadgeLabel}"
                                           TextColor="{DynamicResource AppLabelMuted}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding ActionType}" Value="0">
                                                <Setter Property="Text" Value="{x:Static localization:AppResources.ActionBadgeDefault}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding ActionType}" Value="1">
                                                <Setter Property="Text" Value="🔊 {x:Static localization:AppResources.ActionBadgeHorn}" />
                                                <Setter Property="TextColor" Value="#cc6666" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding ActionType}" Value="2">
                                                <Setter Property="Text" Value="🌙 {x:Static localization:AppResources.ActionBadgeNight}" />
                                                <Setter Property="TextColor" Value="#6699cc" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>

                                <!-- Chevron tap target -->
                                <Label Grid.Column="3"
                                       Text="›"
                                       FontSize="22"
                                       TextColor="{DynamicResource AppLabelMuted}"
                                       VerticalOptions="Center" />

                            </Grid>

                            <!-- Tap gesture over whole card -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RelayConfigViewModel}}, Path=NavigateToRelayCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <views:StatusBarView Grid.Row="3" />
    </Grid>

</views:BasePowerControlHubContentPage>
