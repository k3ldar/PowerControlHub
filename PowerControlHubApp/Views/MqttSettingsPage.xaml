<?xml version="1.0" encoding="utf-8" ?>
<views:BasePowerControlHubContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:PowerControlHubApp.Views"
             xmlns:localization="clr-namespace:PowerControlHubApp.Resources.Localization"
             x:Class="PowerControlHubApp.Views.MqttSettingsPage"
             Title="{x:Static localization:AppResources.MqttSettingsTitle}"
             BackgroundColor="{DynamicResource AppPageBg}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" BackgroundColor="{DynamicResource AppPageBg}">

        <views:TopBarView Grid.Row="0" Title="{x:Static localization:AppResources.MqttSettingsTitle}" ShowBackButton="True" />

        <views:NotConnectedBanner Grid.Row="1" />

        <ScrollView Grid.Row="2" IsVisible="{Binding IsConnected}">
            <VerticalStackLayout Padding="20" Spacing="12">

                <!-- Connection card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}"
                        Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.Connection}"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{x:Static localization:AppResources.MqttEnabledLabel}"
                                   TextColor="{DynamicResource AppEntryText}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding MqttEnabled}"
                                    OnColor="{DynamicResource AppAccent}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{DynamicResource AppHelpCardStroke}"
                                 Margin="0,4" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{x:Static localization:AppResources.MqttConnectionStateLabel}"
                                   TextColor="{DynamicResource AppEntryText}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding MqttConnectionStateText}"
                                   TextColor="{DynamicResource AppAccent}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Broker card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}"
                        Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.MqttBrokerLabel}"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13" />

                        <Label Text="{x:Static localization:AppResources.HostIp}"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11" />
                        <Entry Text="{Binding MqttBroker}"
                               Placeholder="{x:Static localization:AppResources.PlaceholderIpAddress}"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />

                        <Label Text="{x:Static localization:AppResources.MqttPortLabel}"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11"
                               Margin="0,8,0,0" />
                        <Entry Text="{Binding MqttPort}"
                               Placeholder="{x:Static localization:AppResources.PlaceholderMqttPort}"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <!-- Credentials card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}"
                        Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.Credentials}"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13" />

                        <Label Text="{x:Static localization:AppResources.MqttUsernameLabel}"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11" />
                        <Entry Text="{Binding MqttUsername}"
                               Placeholder="{x:Static localization:AppResources.LeaveEmptyForNone}"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />

                        <Label Text="{x:Static localization:AppResources.MqttPasswordLabel}"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11"
                               Margin="0,8,0,0" />
                        <Entry Text="{Binding MqttPassword}"
                               Placeholder="{x:Static localization:AppResources.EnterPasswordToChange}"
                               IsPassword="True"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <!-- Device card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}"
                        Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.DeviceIdentity}"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13" />

                        <Label Text="{x:Static localization:AppResources.MqttDeviceIdLabel}"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11" />
                        <Entry Text="{Binding MqttDeviceId}"
                               Placeholder="{x:Static localization:AppResources.MqttDeviceIdPlaceholder}"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />

                        <Label Text="{x:Static localization:AppResources.MqttDiscoveryPrefixLabel}"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11"
                               Margin="0,8,0,0" />
                        <Entry Text="{Binding MqttDiscoveryPrefix}"
                               Placeholder="{x:Static localization:AppResources.HomeassistantPlaceholder}"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <!-- Advanced card -->
                <Border BackgroundColor="{DynamicResource AppHelpCardBg}"
                        Stroke="{DynamicResource AppHelpCardStroke}"
                        StrokeShape="RoundRectangle 8" Padding="14"
                        Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static localization:AppResources.Advanced}"
                               TextColor="{DynamicResource AppLabelMuted}"
                               FontAttributes="Bold"
                               FontSize="13" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="{x:Static localization:AppResources.MqttHaDiscoveryLabel}"
                                   TextColor="{DynamicResource AppEntryText}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding MqttHADiscovery}"
                                    OnColor="{DynamicResource AppAccent}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{DynamicResource AppHelpCardStroke}"
                                 Margin="0,4" />

                        <Label Text="{x:Static localization:AppResources.KeepAliveSeconds}"
                               TextColor="{DynamicResource AppLabelSubtle}"
                               FontSize="11" />
                        <Entry Text="{Binding MqttKeepAlive}"
                               Placeholder="{x:Static localization:AppResources.PlaceholderKeepAlive}"
                               Keyboard="Numeric"
                               TextColor="{DynamicResource AppEntryText}"
                               PlaceholderColor="{DynamicResource AppPlaceholderText}"
                               BackgroundColor="{DynamicResource AppEntryBg}"
                               FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <!-- Save All button -->
                <Button Text="{x:Static localization:AppResources.SaveAllSettings}"
                        Command="{Binding SaveAllCommand}"
                        BackgroundColor="{DynamicResource AppAccent}"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="10,8"
                        FontSize="16"
                        FontAttributes="Bold"
                        Margin="0,8,0,0" />

                <!-- Status -->
                <Label Text="{Binding StatusMessage}"
                       TextColor="{DynamicResource AppAccent}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding HasStatusMessage}" />
            </VerticalStackLayout>
        </ScrollView>

        <views:StatusBarView Grid.Row="3" />
    </Grid>

</views:BasePowerControlHubContentPage>
