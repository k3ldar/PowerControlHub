<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PowerControlHubApp.Views.TopBarView"
             x:Name="TopBar">

    <Grid Padding="12,10" ColumnDefinitions="Auto,*,Auto"
          BackgroundColor="{DynamicResource AppBarBg}">

        <!-- Menu button -->
        <Button Grid.Column="0"
                Text="☰"
                FontSize="20"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource AppBarText}"
                Padding="0,0,8,0"
                Clicked="OnMenuClicked"
                IsVisible="{Binding Source={x:Reference TopBar}, Path=ShowMenuButton}" />

        <!-- Back button -->
        <Button Grid.Column="0"
                Text="‹"
                FontSize="20"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource AppBarText}"
                Padding="0,0,8,0"
                Clicked="OnBackClicked"
                IsVisible="{Binding Source={x:Reference TopBar}, Path=ShowBackButton}" />

        <!-- Title -->
        <Label Grid.Column="1"
               Text="{Binding Source={x:Reference TopBar}, Path=Title}"
               TextColor="{DynamicResource AppBarText}"
               FontSize="17"
               FontAttributes="Bold"
               VerticalOptions="Center"
               LineBreakMode="TailTruncation" />

        <!-- Right button -->
        <Button Grid.Column="2"
                Text="{Binding Source={x:Reference TopBar}, Path=RightButtonText}"
                FontSize="18"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource AppBarText}"
                Padding="6,0"
                Command="{Binding Source={x:Reference TopBar}, Path=RightButtonCommand}"
                IsEnabled="{Binding Source={x:Reference TopBar}, Path=RightButtonIsEnabled}"
                IsVisible="{Binding Source={x:Reference TopBar}, Path=HasRightButton}"
                Clicked="OnRightButtonClicked" />
    </Grid>

</ContentView>
